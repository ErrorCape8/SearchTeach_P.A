# Copy this file to .env and replace the value with a private random secret
# of at least 32 bytes before starting the application from the project root.
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes
MONGODB_URI=mongodb://localhost:27017/Searchteach
